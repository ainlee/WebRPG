{
  "env": {
    "browser": true,
    "es2021": true
  },
  "extends": "standard",
  "overrides": [],
  "parserOptions": {
    "ecmaVersion": "latest",
    "sourceType": "module"
  },
  "rules": {
    "no-console": "error",
    "no-unused-vars": "error",
    "semi": ["error", "never"],
    "eol-last": ["error", "always"],
    "linebreak-style": ["error", "unix"]
  }
}